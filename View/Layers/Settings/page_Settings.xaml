<Page x:Class="college_events_desktop.View.Layers.Settings.page_Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:college_events_desktop.View.Layers.Settings"
      mc:Ignorable="d" 
      Height="400"
      Width="700"
      Title="page_Settings">

    <Grid Background="White">
        <StackPanel Margin="10">
            <TextBlock Text="Настройки" FontSize="18" FontWeight="Bold" Foreground="#FF676767" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>
            <Border Margin="0,20,0,20" Height="2" Background="#FFDDEEFF"/>
            
            <Grid Margin="30,0,30,0">
                <TextBlock Text="Сбросить положение плавающих элементов" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="14" HorizontalAlignment="Left"/>
                <TextBlock Text="Перезапуск приложения со стандартными положениями плавающих элементов" TextWrapping="Wrap" VerticalAlignment="Bottom" HorizontalAlignment="Left" Foreground="#FF676767"/>
                <Button x:Name="btn_reset_moving_menus" Margin="10,0,0,0" Width="40" Height="40" Style="{DynamicResource ButtonStyle_accent}" Click="btn_reset_moving_menus_Click" HorizontalAlignment="Right">
                    <Border Width="20" Height="20" Background="White">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/View/Resources/icons/ico_rotate_reverse.png"/>
                        </Border.OpacityMask>
                    </Border>
                </Button>
            </Grid>

        </StackPanel>
    </Grid>
</Page>
