<Page x:Class="college_events_desktop.View.Layers.page_EventList"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	  xmlns:local="clr-namespace:college_events_desktop.View.Layers"
	  xmlns:controller="clr-namespace:college_events_desktop.View.Controls" 
      mc:Ignorable="d" 
	  d:DesignHeight="550" d:DesignWidth="1000"
	  Title="Список мероприятий">


    <Grid Background="White" Grid.Row="1" Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="145"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!--Заголовок-->
        <StackPanel Background="#FFDDEEFF" Orientation="Horizontal">
            <Button x:Name="btn_update_page" Padding="5" VerticalAlignment="Center" Style="{DynamicResource ButtonStyle_accent}" Margin="10,0,0,0" Click="update_page_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" Width="20" Height="20">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/View/Resources/ico_rotate_reverse.png"/>
                        </Border.OpacityMask>
                    </Border>
                    <TextBlock Text="Обновить страницу" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <Button Padding="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,5,0" Style="{DynamicResource ButtonStyle_accent}" BorderBrush="{x:Null}" Click="go_EventListHelp">
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" Height="20" Width="20">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/View/Resources/ico_question.png"/>
                        </Border.OpacityMask>
                    </Border>
                    <TextBlock Text="Помощь" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="18" Text="Список мероприятий" FontWeight="Bold" Foreground="#FF666666"/>
        </StackPanel>

        <!--Тело-->
        <StackPanel Grid.Row="1" Margin="5">

            <!--Область фильтров-->
            <Border BorderThickness="1" CornerRadius="10" Height="70" BorderBrush="#FF666666" Margin="0,10,0,0">
                <Grid>
                    <Border CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="80" Background="#FF008CFF" Margin="10,-9,0,0" Height="20">
                        <TextBlock Foreground="White" FontSize="14" Text="Фильтры" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Border>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btn_gray_filter" Tag="4"  Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" Cursor="Hand" Click="btn_any_filter_click" Style="{DynamicResource ButtonStyle_filter}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="text_filter_gray" Text="Только" Foreground="#FF666666" FontSize="14"/>
                                <Ellipse Width="10" Height="10" Margin="5,0,0,0" Fill="#FFA7A7A7"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btn_blue_filter" Tag="3" Style="{DynamicResource ButtonStyle_filter}" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" Grid.Column="1" Cursor="Hand" Click="btn_any_filter_click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="text_filter_blue" Text="Только" Foreground="#FF666666" FontSize="14"/>
                                <Ellipse Width="10" Height="10" Margin="5,0,0,0" Fill="#FF48AFFF"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btn_yellow_filter" Tag="1" Style="{DynamicResource ButtonStyle_filter}" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" Grid.Column="2" Cursor="Hand" Click="btn_any_filter_click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="text_filter_yellow" Text="Только" Foreground="#FF666666" FontSize="14"/>
                                <Ellipse Width="10" Height="10" Margin="5,0,0,0" Fill="#FFFFDD3C"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btn_red_filter" Tag="-1" Style="{DynamicResource ButtonStyle_filter}" Background="White" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" Grid.Column="3" Cursor="Hand" Click="btn_any_filter_click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="text_filter_red" Text="Только" Foreground="#FF666666" FontSize="14"/>
                                <Ellipse Width="10" Height="10" Margin="5,0,0,0" Fill="#FFFF4949"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btn_green_filter" Tag="2" Style="{DynamicResource ButtonStyle_filter}" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5" Grid.Column="4" Background="White" Cursor="Hand" Click="btn_any_filter_click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="text_filter_green" Text="Только" Foreground="#FF666666" FontSize="14"/>
                                <Ellipse Width="10" Height="10" Margin="5,0,0,0" Fill="#FF66FF3D"/>
                            </StackPanel>
                        </Button>

                        <controller:SearchBar TextChanged="search_textChanged" Grid.Column="5" Margin="5,0,5,0"/>

                        <ComboBox x:Name="combobox_categories" Grid.Column="6" 
								  VerticalAlignment="Center" 
                                  Margin="5,0,5,0" 
                                  BorderBrush="{x:Null}" 
                                  Cursor="Hand" 
                                  FontSize="16" SelectionChanged="combobox_categories_SelectionChanged"/>

                    </Grid>
                </Grid>
            </Border>

            <!--Заголовки мероприятий-->
            <Grid Height="40" Margin="5,10,23,0" Background="#FFDDEEFF" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="0.6*"/>
                    <ColumnDefinition Width="0.6*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="0.7*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <Border BorderThickness="1, 1, 0, 1" BorderBrush="Black">
                    <TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Название" FontWeight="Bold" FontSize="14"/>
                </Border>
                <Border BorderThickness="1, 1, 0, 1" BorderBrush="Black" Grid.Column="1">
                    <TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Text="ФИО организатора" FontSize="14"/>
                </Border>
                <Border BorderThickness="1, 1, 0, 1" BorderBrush="Black" Grid.Column="2">
                    <TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Время" FontWeight="Bold" FontSize="14"/>
                </Border>
                <Border BorderThickness="1, 1, 0, 1" BorderBrush="Black" Grid.Column="3">
                    <TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Дата" FontWeight="Bold" FontSize="14"/>
                </Border>
                <Border BorderThickness="1, 1, 0, 1" BorderBrush="Black" Grid.Column="4">
                    <TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Направление" FontSize="14"/>
                </Border>
                <Border BorderThickness="1, 1, 0, 1" BorderBrush="Black" Grid.Column="5">
                    <TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Место" FontWeight="Bold" FontSize="14"/>
                </Border>
                <Border BorderThickness="1, 1, 1, 1" BorderBrush="Black" Grid.Column="6">
                    <TextBlock TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Действия" FontSize="14"/>
                </Border>
            </Grid>
        </StackPanel>


        <!--Область отображения мероприятий-->
        <ScrollViewer x:Name="MainScrollViewer" 
                      Style="{DynamicResource MinimalScrollViewerStyle}"
                      Margin="5,0,5,5" 
                      HorizontalScrollBarVisibility="Disabled" 
                      VerticalScrollBarVisibility="Visible"
                      Grid.Row="2">
            <StackPanel x:Name="stack_events"/>
        </ScrollViewer>

        <!--Отображение количества мероприяий-->
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">

            <TextBlock Text="Показано мероприятий: " Grid.Row="3" HorizontalAlignment="Left"/>
            <TextBlock x:Name="text_amount_of_events" Text="0"/>

            <Border CornerRadius="10" Margin="40,0,0,0" Width="16" Background="#FFA7A7A7"/>
            <TextBlock Text=" : "/>
            <TextBlock x:Name="text_amount_of_gray" Text="0"/>

            <Border CornerRadius="10" Margin="20,0,0,0" Width="16" Background="#FF48AFFF"/>
            <TextBlock Text=" : "/>
            <TextBlock x:Name="text_amount_of_blue" Text="0"/>

            <Border CornerRadius="10" Margin="20,0,0,0" Width="16" Background="#FF66FF3D"/>
            <TextBlock Text=" : "/>
            <TextBlock x:Name="text_amount_of_green" Text="0"/>

            <Border CornerRadius="10" Margin="20,0,0,0" Width="16" Background="#FFFFDD3C"/>
            <TextBlock Text=" : "/>
            <TextBlock x:Name="text_amount_of_yellow" Text="0"/>

            <Border CornerRadius="10" Margin="20,0,0,0" Width="16" Background="#FFFF4949"/>
            <TextBlock Text=" : "/>
            <TextBlock x:Name="text_amount_of_red" Text="0"/>

        </StackPanel>

    </Grid>
</Page>