<Page x:Class="college_events_desktop.View.Layers.Organizers.page_Organizer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:college_events_desktop.View.Layers.Organizers"
      xmlns:control="clr-namespace:college_events_desktop.View.Controls"
      xmlns:container="clr-namespace:college_events_desktop.View.Controls.Containers"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="800"
      Title="Просмотр статистики организатора"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!--Заголовок-->
        <Border Background="#FFDDEEFF">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="text_header" d:Text="_authorizedUser.surName _authorizedUser.firstName _authorizedUser.lastName" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="18" FontWeight="Bold" Foreground="#FF666666">
                    <TextBlock.Text>
                        <MultiBinding Mode="OneTime" StringFormat="{} {0} {1} {2}">
                            <Binding Path="surName"/>
                            <Binding Path="firstName"/>
                            <Binding Path="lastName"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text=". Просмотр статистики организатора" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#FF666666"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{DynamicResource MinimalScrollViewerStyle}" Margin="10,5,10,0">
            <StackPanel>

                <!--Формы заполнения-->
                <Border Margin="0,20,0,15" Height="2" Background="#FFDDEEFF"/>
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <!--кол-в0 мероприятий-->
                        <RowDefinition/>
                        <!--кол-во студентов-->
                        <RowDefinition/>
                        <!--кол-во кураторов-->
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.6*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3">
                        <TextBlock Text="Количество мероприятий" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="18" ToolTip="Количество прошедших мероприятий, которые были предложены данным организатором"/>
                    </Border>
                    <TextBox x:Name="edit_events_count" IsReadOnly="True" Text="{Binding eventsCount}" Margin="5" Grid.Row="0" d:Text="_organizerStatistic.eventsCount" VerticalContentAlignment="Center" Foreground="#FF666666" FontSize="18" VerticalAlignment="Center" Grid.Column="1"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="1">
                        <TextBlock Text="Количество студентов" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="18" Grid.Row="1"/>
                    </Border>
                    <TextBox x:Name="edit_students_count" IsReadOnly="True" Text="{Binding studentsCount}" d:Text="_organizerStatistic.studentsCount" FontSize="18" Margin="5" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="#FF666666" VerticalContentAlignment="Center"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="2">
                        <TextBlock Text="Количество кураторов" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="18" Grid.Row="2"/>
                    </Border>
                    <TextBox x:Name="edit_supervisors_count" IsReadOnly="True" Text="{Binding supervisorsCount}" d:Text="_organizerStatistic.supervisorsCount" Margin="5" Grid.Column="1" FontSize="18" Grid.Row="2" VerticalAlignment="Center" Foreground="#FF666666" VerticalContentAlignment="Center"/>

                </Grid>

                <Border Margin="0,20,0,15" Height="2" Background="#FFDDEEFF"/>

                
                <!--область фильтров-->
                <Border BorderThickness="1" CornerRadius="10" Height="70" BorderBrush="#FF666666" Margin="0,10,0,0" Background="White">
                    <Grid>
                        <Border CornerRadius="5" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="80" Background="White" Margin="10,-9,0,0" Height="20" BorderBrush="#FF666666">
                            <TextBlock Foreground="#FF666666" FontSize="14" Text="Фильтры" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        </Border>
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="0.7*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <control:SearchBar TextChanged="search_textChanged" 
                                               Grid.Column="0" 
                                               Margin="5,0,5,0" VerticalAlignment="Center">
                            </control:SearchBar>


                            <ComboBox x:Name="combobox_categories" Grid.Column="1" 
								      VerticalAlignment="Center" 
                                      Margin="5,0,5,0" 
                                      Cursor="Hand" 
                                      FontSize="16" 
                                      SelectionChanged="combobox_categories_SelectionChanged" 
                                      ToolTip="Поиск по направлению" Style="{DynamicResource ModernComboBoxStyle}" Height="30"/>

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Дата:" VerticalAlignment="Center" FontSize="14" Margin="5,0,5,0"/>
                                <DatePicker x:Name="datepicker_from" Grid.Column="1" SelectedDateChanged="datepicker_date_changed" BorderBrush="#FFABADB3" FontSize="14" ToolTip="Начало периода" VerticalAlignment="Center" Style="{DynamicResource ModernDatePickerStyle}"/>

                                <TextBlock Grid.Column="2" Text="—" VerticalAlignment="Center" FontSize="14" Margin="5,0,5,0"/>
                                <DatePicker x:Name="datepicker_to" Grid.Column="3" SelectedDateChanged="datepicker_date_changed" VerticalAlignment="Center" BorderBrush="#FFABADB3" FontSize="14" ToolTip="Конец периода" Style="{DynamicResource ModernDatePickerStyle}"/>
                            </Grid>

                        </Grid>
                    </Grid>
                </Border>


                <Border Margin="0,20,0,15" Height="2" Background="#FFDDEEFF"/>
                
                <TextBlock Text="Прошедшие мероприятия" FontSize="16" FontWeight="Bold" Foreground="#FF666666"/>
                <DataGrid x:Name="datagrid_events" AutoGenerateColumns="False"  Margin="0,10,0,0" Style="{DynamicResource CustomDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Мероприятие" Width="*" Binding="{Binding title}" CanUserResize="True" CanUserSort="True"/>
                        <DataGridTextColumn Width="0.6*" Header="Дата и время" CanUserSort="True" CanUserResize="True">
                            <DataGridTextColumn.Binding>
                                <!--тут вынуждено задаём формат вывода, потому что не хочу писать отдельно конвертатор под этот вывод-->
                                <MultiBinding StringFormat="{}{0:dd.MM.yyyy HH.mm} — {1:HH.mm}">
                                    <Binding Path="startDatetime"/>
                                    <Binding Path="endDatetime"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Width="*" Header="Описание" Binding="{Binding fullDescription}" CanUserSort="False" CanUserResize="True"/>
                        <DataGridTextColumn Width="0.3*" Header="Слушатели" Binding="{Binding actualListenersCount}" CanUserSort="True" CanUserResize="True"/>
                        <DataGridTextColumn Width="0.3*" Header="Участники" Binding="{Binding actualParticipantsCount}" CanUserResize="True" CanUserSort="True"/>
                        <DataGridTextColumn Width="0.3*" Header="Супер-участники" Binding="{Binding actualSuperParticipantsCount}" CanUserResize="True" CanUserSort="True"/>
                        <DataGridTextColumn Width="0.3*" Header="Общий балл" Binding="{Binding totalScore}" CanUserResize="True" CanUserSort="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>



        <!--Навигация-->
        <StackPanel x:Name="stack_nav" Margin="5" Orientation="Horizontal" Grid.Row="2">
            <Button x:Name="btn_export" Style="{DynamicResource ButtonStyle_accent}" Width="140" FontSize="14" Content="Экспорт" Margin="10,0,0,0"/>
            <Button x:Name="btn_open_diagram" Style="{DynamicResource ButtonStyle_accent}" Width="170" FontSize="14" Content="Показать диаграмму" Margin="10,0,0,0" Background="#FF0070CC"/>
        </StackPanel>
    </Grid>
</Page>
