<Page x:Class="college_events_desktop.View.Layers.Organizers.page_Organizer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:college_events_desktop.View.Layers.Organizers"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="800"
      Title="Просмотр статистики организатора"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!--Заголовок-->
        <Border Background="#FFDDEEFF">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="text_header" d:Text="_authorizedUser.surName _authorizedUser.firstName _authorizedUser.lastName" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="18" FontWeight="Bold" Foreground="#FF666666">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{} {0} {1} {2}">
                            <Binding Path="surName"/>
                            <Binding Path="firstName"/>
                            <Binding Path="lastName"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text=". Просмотр статистики организатора" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#FF666666"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{DynamicResource MinimalScrollViewerStyle}" Margin="10,5,10,0">
            <StackPanel>

                <!--Формы заполнения-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <!--кол-в0 мероприятий-->
                        <RowDefinition/>
                        <!--кол-во студентов-->
                        <RowDefinition/>
                        <!--кол-во кураторов-->
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3">
                        <TextBlock Text="Количество мероприятий" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" ToolTip="Количество прошедших мероприятий, которые были предложены данным организатором"/>
                    </Border>
                    <TextBox x:Name="edit_event_name" Text="{Binding eventsCount}" Margin="5" Grid.Row="0" d:Text="_organizerStatistic.eventsCount" VerticalContentAlignment="Center" Foreground="#FF666666" FontSize="14" VerticalAlignment="Center" Padding="2,1,0,2" Grid.Column="1"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="1">
                        <TextBlock Text="Количество студентов" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Grid.Row="1"/>
                    </Border>
                    <TextBox x:Name="edit_organizer_name" Text="{Binding studentsCount}" d:Text="_organizerStatistic.studentsCount" FontSize="14" Margin="5" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="#FF666666" Height="24" VerticalContentAlignment="Center">
                        
                    </TextBox>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="2">
                        <TextBlock Text="Количество кураторов" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Grid.Row="2"/>
                    </Border>
                    <TextBox x:Name="edit_event_direction" Text="{Binding supervisorsCount}" d:Text="_organizerStatistic.supervisorsCount" Margin="5" Grid.Column="1" FontSize="14" Grid.Row="2" VerticalAlignment="Center" Foreground="#FF666666" VerticalContentAlignment="Center" Height="24"/>

                </Grid>

                <Border Margin="0,20,0,15" Height="2" Background="#FFDDEEFF"/>
                <TextBlock Text="Прошедшие мероприятия" FontSize="16" FontWeight="Bold" Foreground="#FF666666"/>
                <DataGrid x:Name="datagrid_events" AutoGenerateColumns="False"  Margin="0,10,0,0" Style="{DynamicResource CustomDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Мероприятие" Width="*" Binding="{Binding title}" CanUserResize="True" CanUserSort="True"/>
                        <DataGridTextColumn Width="0.6*" Header="Дата" Binding="{Binding startDatetime, Converter={StaticResource DateTimeConverter}}" CanUserSort="True" CanUserResize="True"/>
                        <DataGridTextColumn Width="*" Header="Описание" Binding="{Binding fullDescription}" CanUserSort="False" CanUserResize="True"/>
                        <DataGridTextColumn Width="0.3*" Header="Слушатели" Binding="{Binding actualListenersCount}" CanUserSort="True" CanUserResize="True"/>
                        <DataGridTextColumn Width="0.3*" Header="Участники" Binding="{Binding actualParticipantsCount}" CanUserResize="True" CanUserSort="True"/>
                        <DataGridTextColumn Width="0.3*" Header="Супер-участники" Binding="{Binding actualSuperParticipantsCount}" CanUserResize="True" CanUserSort="True"/>
                        <DataGridTextColumn Width="0.3*" Header="Общий балл" Binding="{Binding totalScore}" CanUserResize="True" CanUserSort="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>



        <!--Навигация-->
        <StackPanel x:Name="stack_nav" Margin="5" Orientation="Horizontal" Grid.Row="2">
            <Button x:Name="btn_goback" Style="{DynamicResource ButtonStyle_accent_extra}" Width="140" FontSize="14" Content="Назад"/>
            <Button x:Name="btn_export" Style="{DynamicResource ButtonStyle_accent}" Width="140" FontSize="14" Content="Экспорт" Margin="10,0,0,0"/>
            <Button x:Name="btn_open_diagram" Style="{DynamicResource ButtonStyle_accent}" Width="170" FontSize="14" Content="Показать диаграмму" Margin="10,0,0,0" Background="#FF0070CC"/>
        </StackPanel>
    </Grid>
</Page>
