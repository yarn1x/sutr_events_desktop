<Page x:Class="college_events_desktop.View.Layers.Events.page_EventList_seeEvent"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:college_events_desktop.View.Layers.Events"
      xmlns:DataModels="clr-namespace:college_events_desktop.DataModels" 
      mc:Ignorable="d" 
      d:DesignHeight="900" 
      d:DesignWidth="800"
      Title="Просмотр отчёта"
      Background="White">

    <Page.DataContext>
        <DataModels:Event/>
    </Page.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!--Заголовок-->
        <Border Background="#FFDDEEFF">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="text_header" d:Text="_Event.title" Text="{Binding title}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="18" FontWeight="Bold" Foreground="#FF666666"/>
                <TextBlock Text=". Просмотр статистики" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#FF666666"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{DynamicResource MinimalScrollViewerStyle}" Margin="10,5,10,0">
            <StackPanel>

                <!--Формы заполнения-->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <!--название мероприятия-->
                        <RowDefinition/>
                        <!--организатор-->
                        <RowDefinition/>
                        <!--направление-->
                        <RowDefinition/>
                        <!--места-->
                        <RowDefinition/>
                        <!--дата проведения-->
                        <RowDefinition/>
                        <!--время начала-->
                        <RowDefinition/>
                        <!--время окончания-->
                        <RowDefinition/>
                        <!--полное описание-->
                        <RowDefinition/>
                        <!--краткое описание-->
                        <RowDefinition/>
                        <!--дополнительно-->
                        <RowDefinition/>
                        <!--макс. число слушателей-->
                        <RowDefinition/>
                        <!--макс. число участников-->
                        <RowDefinition/>
                        <!--внешняя организация-->
                        <RowDefinition/>
                        <!--внешняя должность организатора-->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.4*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3">
                        <TextBlock Text="Название мероприятия" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14"/>
                    </Border>
                    <TextBox x:Name="edit_event_name" Margin="5" Grid.Row="0" Text="{Binding title}" d:Text="_Event.title" VerticalContentAlignment="Center" Foreground="#FF666666" FontSize="14" VerticalAlignment="Center" Padding="2,1,0,2" Grid.Column="1"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="1">
                        <TextBlock Text="Организатор" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Grid.Row="1"/>
                    </Border>
                    <TextBox x:Name="edit_organizer_name" d:Text="" FontSize="14" Margin="5" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Foreground="#FF666666" Height="24" VerticalContentAlignment="Center">
                        <TextBox.Text>
                            <MultiBinding StringFormat="{}{0} {1} {2}">
                                <Binding Path="organizerSurname"/>
                                <Binding Path="organizerName"/>
                                <Binding Path="organizerLastname"/>
                            </MultiBinding>
                        </TextBox.Text>
                    </TextBox>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="2">
                        <TextBlock Text="Направление" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Grid.Row="2"/>
                    </Border>
                    <TextBox x:Name="edit_event_direction" Text="{Binding categoryName}" d:Text="_Event.categoryName" Margin="5" Grid.Column="1" FontSize="14" Grid.Row="2" VerticalAlignment="Center" Foreground="#FF666666" VerticalContentAlignment="Center" Height="24"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="3">
                        <TextBlock Text="Места" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14" Grid.Row="3"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Grid.Row="3" Grid.Column="1">
                        <StackPanel x:Name="stack_places" Orientation="Horizontal" >

                        </StackPanel>
                    </ScrollViewer>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="4">
                        <TextBlock Text="Дата проведения" FontSize="14" HorizontalAlignment="Left" Grid.Row="4" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_date" Text="{Binding startDateTime, Mode=OneWay, Converter={StaticResource DateTimeConverter}, ConverterParameter=dd.MM.yyyy}" d:Text="_Event.startDate" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" Margin="5" Width="150" FontSize="14" Foreground="#FF666666" BorderBrush="#FFABADB3" Cursor="Hand" Height="24" VerticalContentAlignment="Center"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="5">
                        <TextBlock Text="Время начала" FontSize="14" HorizontalAlignment="Left" Grid.Row="5" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_startTime" d:Text="_Event.startTime" Margin="5" FontSize="14" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Height="24" VerticalContentAlignment="Center" Foreground="#FF666666">
                        <Binding Path="startDateTime" Mode="OneWay" NotifyOnValidationError="True" Converter="{StaticResource DateTimeConverter}" ConverterParameter="HH:mm">
                            <Binding.ValidationRules>
                                <ExceptionValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="6">
                        <TextBlock Text="Время окончания" FontSize="14" HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_endTime" d:Text="_Event.endTime" Margin="5" FontSize="14" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="150" Height="24" VerticalContentAlignment="Center" Foreground="#FF666666">
                        <Binding Path="endDateTime" NotifyOnValidationError="True"  Converter="{StaticResource DateTimeConverter}" ConverterParameter="HH:mm">
                            <Binding.ValidationRules>
                                <ExceptionValidationRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox>
                    <TextBlock x:Name="text_debug" d:Text="debug_string" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="180,0,0,0"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="7">
                        <TextBlock Text="Полное описание" FontSize="14" HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_fullDescription" Text="{Binding fullDescription}" d:Text="_Event.fullDescription" TextWrapping="Wrap" Grid.Row="7" Grid.Column="1" Foreground="#FF666666" FontSize="14" Padding="2,1,2,3" Margin="5,5,5,5"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="8">
                        <TextBlock Text="Краткое описание" FontSize="14" HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_shortDescription" Text="{Binding shortDescription}" d:Text="_Event.shortDescription" TextWrapping="Wrap" Grid.Row="8" Grid.Column="1" Foreground="#FF666666" FontSize="14" Padding="2,1,2,3" Margin="5,5,5,5"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="9">
                        <TextBlock Text="Дополнительно" FontSize="14" HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_additionalInfo" Text="{Binding additionalInfo}" d:Text="_Event.additionalInfo" TextWrapping="Wrap" Grid.Row="9" Grid.Column="1" Foreground="#FF666666" FontSize="14" Padding="2,1,2,3" Margin="5,5,5,5"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="10">
                        <TextBlock Text="Максимальное число слушателей" FontSize="14" HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_maxListenersCount" Text="{Binding maxListenersCount}" d:Text="_Event.maxListenersCount" TextWrapping="Wrap" Grid.Row="10" Grid.Column="1" Foreground="#FF666666" FontSize="14" Padding="2,1,2,3" Margin="5,5,5,5" Width="150" HorizontalAlignment="Left"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="11">
                        <TextBlock Text="Максимальное число участников" FontSize="14" HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_maxParticipantsCount" Text="{Binding maxParticipantsCount}" d:Text="_Event.maxParticipantsCount" TextWrapping="Wrap" Grid.Row="11" Grid.Column="1" Foreground="#FF666666" FontSize="14" Padding="2,1,2,3" Margin="5,5,5,5" HorizontalAlignment="Left" Width="150"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="12">
                        <TextBlock Text="Внешняя орагнизация" FontSize="14" HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_organizerOrganization" Text="{Binding organizerOrganization}" d:Text="_Event.organizerOrganization" TextWrapping="Wrap" Grid.Row="12" Grid.Column="1" Foreground="#FF666666" FontSize="14" Padding="2,1,2,3" Margin="5,5,5,5"/>

                    <Border CornerRadius="0, 0, 5, 0" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Grid.Row="13">
                        <TextBlock Text="Должность организатора" FontSize="14" HorizontalAlignment="Left" Grid.Row="6" VerticalAlignment="Center"/>
                    </Border>
                    <TextBox x:Name="edit_organizerPosition" Text="{Binding organizerPosition}" d:Text="_Event.organizerPosition" TextWrapping="Wrap" Grid.Row="13" Grid.Column="1" Foreground="#FF666666" FontSize="14" Padding="2,1,2,3" Margin="5,5,5,5"/>

                </Grid>

                <Border Margin="0,20,0,15" Height="2" Background="#FFDDEEFF"/>
                <TextBlock Text="Зарегистрированные группы на мероприятие" FontSize="16" FontWeight="Bold" Foreground="#FF666666"/>
                <DataGrid x:Name="datagrid_groups" AutoGenerateColumns="False"  Margin="0,10,0,0" Style="{DynamicResource CustomDataGridStyle}">
                    <DataGrid.Columns>
                        <!-- название группы -->
                        <DataGridTextColumn Header="Группа" Width="*" Binding="{Binding groupName}"/>

                        <!-- ФИО руководителя (объединение трёх полей) -->
                        <DataGridTextColumn Width="*" Header="Руководитель">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                    <Binding Path="supervisorSurname"/>
                                    <Binding Path="supervisorName"/>
                                    <Binding Path="supervisorLastname"/>
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <!--кол-во слушателей-->
                        <DataGridTextColumn Width="*" Header="Слушатели" Binding="{Binding actualListenersCount}"/>
                        <!--кол-во участников-->
                        <DataGridTextColumn Width="*" Header="Участники" Binding="{Binding actualParticipantsCount}"/>
                        <!--кол-во суперучастников-->
                        <DataGridTextColumn Width="*" Header="Супер-участники" Binding="{Binding actualSuperParticipantsCount}"/>
                        <!--балл группе за мероприятие-->
                        <DataGridTextColumn Width="*" Header="Общий балл" Binding="{Binding totalScore}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>



        <!--Навигация-->
        <StackPanel x:Name="stack_nav" Margin="5" Orientation="Horizontal" Grid.Row="2">
            <Button x:Name="btn_goback" Style="{DynamicResource ButtonStyle_accent_extra}" Width="140" FontSize="14" Content="Назад" Click="goback_Click"/>
            <Button x:Name="btn_export" Style="{DynamicResource ButtonStyle_accent}" Width="140" FontSize="14" Content="Экспорт" Margin="10,0,0,0" Click="btn_export_Click"/>
            <Button x:Name="btn_open_diagram" Style="{DynamicResource ButtonStyle_accent}" Width="170" FontSize="14" Content="Показать диаграмму" Margin="10,0,0,0" Background="#FF0070CC"/>
        </StackPanel>
    </Grid>
</Page>
