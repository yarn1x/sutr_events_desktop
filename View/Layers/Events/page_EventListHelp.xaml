<Page x:Class="college_events_desktop.View.Layers.Events.page_EventListHelp"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:college_events_desktop.View.Layers.Events"
      mc:Ignorable="d" 
      d:DesignHeight="900" d:DesignWidth="800"
      Title="Справочный материал по списку мероприятий">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        <!--Шапка-->
        <Border Background="#FFDDEEFF" Height="50">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="18" Text="Список мероприятий. Справочный материал" FontWeight="Bold" Foreground="#FF666666"/>
        </Border>

        <!--Тело-->
        <Border Grid.Row="1" Grid.RowSpan="2" Background="#FFF1F1F1"/>
        <ScrollViewer Margin="10" Grid.Row="1" Background="White">
            <StackPanel Margin="10">
                <TextBlock Text="Цветовые обозначения статусов мероприятия" FontWeight="Bold" HorizontalAlignment="Center" FontSize="14"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                    <Border CornerRadius="20" Background="#FFA7A7A7" Width="20" Height="20"/>
                    <TextBlock Text="Мероприятие прошло, отчёт составлен" Margin="10,0,0,0" FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border CornerRadius="20" Background="#FF48AFFF" Width="20" Height="20"/>
                    <TextBlock Text="Мероприятие прошло, требуется составить отчёт" Margin="10,0,0,0" FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border CornerRadius="20" Background="#FFFFDD3C" Width="20" Height="20"/>
                    <TextBlock Text="Предложено новое мероприятие, требуется подтверждение" Margin="10,0,0,0" FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border CornerRadius="20" Background="#FFFF4949" Width="20" Height="20"/>
                    <TextBlock Text="Предложено новое мероприятие, в назначенное время уже существует мероприятие" Margin="10,0,0,0" FontSize="14"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border CornerRadius="20" Background="#FF66FF3D" Width="20" Height="20"/>
                    <TextBlock Text="Мероприятие принято для проведения " Margin="10,0,0,0" FontSize="14"/>
                </StackPanel>

                <Border Margin="-10,10,-10,10" Height="6" Background="#FFF1F1F1"/>

                <TextBlock Text="Подсказки" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="Большинство элементов приложения имеют всплывающие подсказки, если задержать на них курсор мышки." TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="Black" BorderThickness="1" Width="400" HorizontalAlignment="Left">
                            <Image Source="/View/Resources/images/img_ui_tips.png"/>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="1" Width="400" HorizontalAlignment="Left" Margin="20,0,0,0">
                            <Image Source="/View/Resources/images/img_ui_tips_2.png"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Margin="-10,20,-10,10" Height="6" Background="#FFF1F1F1"/>

                <TextBlock Text="Копирование" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Если вы видите значок" TextWrapping="Wrap" FontSize="14"/>
                    <Border Background="#FFD0D0D0" Height="20" Width="20" HorizontalAlignment="Left" Margin="10,0,0,0" >
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/View/Resources/icons/ico_clone.png"/>
                        </Border.OpacityMask>
                    </Border>
                    <TextBlock Text=", значит вы можете скопировать информацию в буфер обмена." Margin="2,0,0,0" FontSize="14"/>
                </StackPanel>
                <Border BorderBrush="Black" BorderThickness="1" Width="400" HorizontalAlignment="Left" Margin="0,20,0,0">
                    <Image Source="/View/Resources/images/img_ui_copy_feature.png"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--Управление-->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Background="White">
            <Button Content="Назад" HorizontalAlignment="Left" Style="{DynamicResource ButtonStyle_accent}" BorderBrush="{x:Null}" Width="140" Height="40" Click="go_back" FontSize="14" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Page>
