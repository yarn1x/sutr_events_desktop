<UserControl x:Class="college_events_desktop.View.Layers.Events.Tables.table_tuple_EventGroup_edit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:college_events_desktop.View.Layers.Events.Tables"
             xmlns:DataModels="clr-namespace:college_events_desktop.DataModels" 
             mc:Ignorable="d" 
             Height="50" d:DesignWidth="800" 
             Background="Transparent">
    <UserControl.DataContext>
        <DataModels:EventGroups/>
    </UserControl.DataContext>
    <Grid x:Name="grid_main">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button x:Name="btn_delete_group" Style="{DynamicResource ButtonStyle_X}" Width="0" Height="20" Cursor="Hand" Content="×" FontSize="22" Padding="1,-8,1,1" Margin="0,0,5,0" Click="btn_delete_group_Click"/>

        <Grid Grid.Column="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border BorderThickness="1, 0, 1, 1" BorderBrush="#FF666666">
                <ComboBox x:Name="combobox_group" IsEditable="True" StaysOpenOnEdit="True" MaxDropDownHeight="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" SelectionChanged="combobox_group_SelectionChanged"/>
            </Border>

            <Border BorderThickness="1, 0, 1, 1" BorderBrush="#FF666666" Grid.Column="1">
                <TextBlock x:Name="text_supervisor_name" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" TextWrapping="Wrap" Text="-"/>
            </Border>

            <Border BorderThickness="1, 0, 1, 1" BorderBrush="#FF666666" Grid.Column="2">
                <TextBox x:Name="edit_expectedListenersCount" Validation.Error="edit_expectedCount_Error" FontSize="14" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Binding Path="expectedListenersCount" NotifyOnValidationError="True">
                        <Binding.ValidationRules>
                            <DataErrorValidationRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
            </Border>

            <Border BorderThickness="1, 0, 1, 1" BorderBrush="#FF666666" Grid.Column="3">
                <TextBox x:Name="edit_expectedParticipantsCount" Validation.Error="edit_expectedCount_Error" FontSize="14" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Binding Path="expectedParticipantsCount" NotifyOnValidationError="True">
                        <Binding.ValidationRules>
                            <DataErrorValidationRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
            </Border>

            <Border BorderThickness="1, 0, 1, 1" BorderBrush="#FF666666" Grid.Column="4">
                <TextBox x:Name="edit_expectedSuperParticipantsCount" Validation.Error="edit_expectedCount_Error" FontSize="14" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Binding Path="expectedSuperParticipantsCount" NotifyOnValidationError="True">
                        <Binding.ValidationRules>
                            <DataErrorValidationRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
            </Border>

            <Border BorderThickness="1, 0, 1, 1" BorderBrush="#FF666666" Grid.Column="5">
                <TextBlock x:Name="text_score" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Grid>
</UserControl>
