<Page x:Class="college_events_desktop.View.Layers.Events.Tables.page_table_EventGroup_edit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:college_events_desktop.View.Layers.Events.Tables"
      mc:Ignorable="d"
      MinHeight="300" d:DesignWidth="800"
      Title="Таблица групп мероприятия.">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <!--Заголовки-->
        <Grid Background="#FFDDEEFF" Margin="5,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="Black" BorderThickness="1, 1, 0, 1">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="Группа"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1, 1, 0, 1" Grid.Column="1">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="Куратор"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1, 1, 0, 1" Grid.Column="2">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="Кол-во слушателей" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1, 1, 0, 1" Grid.Column="3">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="Кол-во активных участников" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1, 1, 0, 1" Grid.Column="4">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="Кол-во супер-участников" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
            <Border BorderBrush="Black" BorderThickness="1, 1, 1, 1" Grid.Column="5">
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Text="Баллы за мероприятие" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
        </Grid>

        <StackPanel x:Name="stack_table_rows" Grid.Row="1"/>
        
    </Grid>
</Page>
