<Page x:Class="college_events_desktop.View.Layers.page_NewLocation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:college_events_desktop.View.Layers"
      mc:Ignorable="d"
      Title="page_NewLocation">

    <Grid Background="White">
        <StackPanel Orientation="Vertical" Margin="20">
            <TextBlock Text="Создание новой локации" VerticalAlignment="Top" HorizontalAlignment="Center" Foreground="#FF666666" FontSize="16"/>
            <Border Margin="0,20,0,10" Height="2" Background="#FFDDEEFF"/>

            <TextBox x:Name="edit_location" TextWrapping="Wrap" Width="450" FontSize="14"/>
            <CheckBox x:Name="check_in_college" Content="В колледже" ToolTip="Указывает на то, что локация находится в колледже" Margin="0,10,0,0" FontSize="14" Cursor="Hand"/>

            <Border Margin="0,10,0,20" Height="2" Background="#FFDDEEFF"/>
            <Button x:Name="btn_upload" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="120" Height="40" Click="btn_upload_Click" Style="{DynamicResource ButtonStyle_accent}" Content="Готово" FontSize="14"/>
        </StackPanel>
    </Grid>
</Page>
