<Page x:Class="college_events_desktop.View.Layers.Users.page_UserList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:control="clr-namespace:college_events_desktop.View.Controls" 
      xmlns:local="clr-namespace:college_events_desktop.View.Layers.Users"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список пользователей">

    <Grid Background="White" Grid.Row="1" Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!--Шапка-->
        <StackPanel Background="#FFDDEEFF" Orientation="Horizontal">
            <Button x:Name="btn_update_page" Padding="5" VerticalAlignment="Center" Style="{DynamicResource ButtonStyle_accent}" Margin="10,0,0,0" Click="btn_update_page_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Background="White" Width="20" Height="20">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/View/Resources/icons/ico_rotate_reverse.png"/>
                        </Border.OpacityMask>
                    </Border>
                    <TextBlock Text="Обновить страницу" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="text_header" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="18" Text="Список пользователей" FontWeight="Bold" Foreground="#FF666666"/>
        </StackPanel>

        <Grid Margin="20, 0, 20, 0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>
            <Border BorderThickness="1" CornerRadius="10" Height="70" BorderBrush="#FF666666" Margin="0,10,0,0" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="5" HorizontalAlignment="Left" VerticalAlignment="Top" Width="80" Background="#FF008CFF" Margin="10,-9,0,0" Height="20">
                        <TextBlock Foreground="White" FontSize="14" Text="Фильтры" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Border>
                    
                    <control:SearchBar Margin="10,0,10,0" VerticalAlignment="Center"/>
                    
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Курс:" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0" Margin="10,0,5,0"/>
                        <ComboBox x:Name="combobox_course_filter" Grid.Column="1" Margin="5,0,10,0" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="btn_filter_admin" Style="{DynamicResource ButtonStyle_filter}" FontSize="14" Content="Администраторы" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5,3,5,4" Grid.Column="2" Margin="10,0,5,0" Click="btn_filter_Click">
                        <Button.Tag>
                            <sys:Int32>1</sys:Int32>
                        </Button.Tag>
                    </Button>
                    <Button x:Name="btn_filter_supervisors" Style="{DynamicResource ButtonStyle_filter}" FontSize="14" Content="Кураторы" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5,3,5,4" Grid.Column="3" Margin="5,0,5,0" Click="btn_filter_Click">
                        <Button.Tag>
                            <sys:Int32>2</sys:Int32>
                        </Button.Tag>
                    </Button>
                    <Button x:Name="btn_filter_organizers" Style="{DynamicResource ButtonStyle_filter}" FontSize="14" Content="Организаторы" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="5,3,5,4" Grid.Column="4" Margin="5,0,10,0" Click="btn_filter_Click">
                        <Button.Tag>
                            <sys:Int32>3</sys:Int32>
                        </Button.Tag>
                    </Button>
                </Grid>
            </Border>


            <Border Height="2" Background="#FFDDEEFF" VerticalAlignment="Bottom"/>

            <ContentControl x:Name="container_content" Margin="10" Grid.Row="1"/>

            <Border Height="2" Background="#FFDDEEFF" VerticalAlignment="Top" Grid.Row="2"/>


            <!--Навигация-->
            <StackPanel x:Name="stack_bottom" Margin="0,7,5,5" Orientation="Horizontal" Grid.Row="6">
                <Button x:Name="btn_goback" Style="{DynamicResource ButtonStyle_accent_extra}" Width="140" FontSize="14" Content="Назад"/>
            </StackPanel>
        </Grid>
    </Grid>

</Page>
