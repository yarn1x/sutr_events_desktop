<UserControl x:Class="college_events_desktop.View.Layers.Users.control_supervisor_group_tuple"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:college_events_desktop.View.Layers.Users"
             mc:Ignorable="d" 
             Background="Transparent" Height="31">
    <Grid HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition MinWidth="170"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition MinWidth="50"/>
        </Grid.ColumnDefinitions>
        
        
        <Button x:Name="btn_delete" 
                Width="23"
                Height="23" 
                Style="{DynamicResource ButtonStyle_X}" 
                FontSize="20" 
                VerticalContentAlignment="Center" 
                HorizontalContentAlignment="Center" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Left" 
                Click="btn_delete_Click" 
                Content="×" 
                Padding="1,-5,1,1"/>

        <TextBlock Text="Группа:" 
                   VerticalAlignment="Center" 
                   Foreground="Gray" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,5,0"/>
        <ComboBox x:Name="combobox_groups"
                  VerticalContentAlignment="Center" 
                  Style="{DynamicResource ModernComboBoxStyle}" 
                  MinWidth="80" 
                  SelectionChanged="combobox_groups_SelectionChanged" Padding="6,3,45,3" Grid.Column="2"/>

        <TextBlock Text="Кол-во учащихся:" 
                   VerticalAlignment="Center" 
                   Foreground="Gray" Grid.Column="3" Margin="0,0,5,0" HorizontalAlignment="Right"/>
        <TextBox x:Name="edit_student_count"
                 FontSize="14" 
                 VerticalContentAlignment="Center" 
                 Padding="2,0,0,0" 
                 MinWidth="40" Grid.Column="4"/>

    </Grid>
</UserControl>
