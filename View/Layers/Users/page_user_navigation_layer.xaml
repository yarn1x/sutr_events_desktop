<Page x:Class="college_events_desktop.View.Layers.Users.page_user_navigation_layer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:college_events_desktop.View.Layers.Users"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="page_user_navigation_layer">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>


        <Grid x:Name="grid_user_nav_layer_basement" Width="0" d:Width="60">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border VerticalAlignment="Top" Height="50" Background="#FFDDEEFF" BorderBrush="#FF666666" BorderThickness="0, 0, 1, 0" />
            <Border Background="White" BorderBrush="#FF666666" BorderThickness="0, 0, 1, 0" Grid.Row="1">
                <StackPanel>
                    <Button x:Name="btn_goback" Padding="10" Margin="5" Style="{DynamicResource ButtonStyle_accent_extra}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="btn_goback_Click" Height="49">
                        <Border Background="#FF9A9A9A" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform Angle="-90"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="/View/Resources/icons/ico_caret_up.png"/>
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                    <Button x:Name="btn_goto_userAccount" d:Visibility="Visible" Visibility="Visible" Padding="10" Margin="5" Style="{DynamicResource ButtonStyle_accent}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Height="49" Click="btn_goto_userAccount_Click" Background="#FF0070CC">
                        <Border Background="White">
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="/View/Resources/icons/ico_user_gear.png"/>
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                    <Button x:Name="btn_goto_supervisorProfile" d:Visibility="Visible" Visibility="Collapsed" Padding="10" Margin="5" Style="{DynamicResource ButtonStyle_accent}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Height="49" Click="btn_goto_supervisorProfile_Click" Background="#FF0070CC">
                        <Border Background="White">
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="/View/Resources/icons/ico_glasses.png"/>
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                    <Button x:Name="btn_goto_organizerProfile" d:Visibility="Visible" Visibility="Collapsed" Padding="10" Margin="5" Style="{DynamicResource ButtonStyle_accent}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Height="49" Click="btn_goto_organizerProfile_Click" Background="#FF0070CC">
                        <Border Background="White">
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="/View/Resources/icons/ico_idea.png"/>
                            </Border.OpacityMask>
                        </Border>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>


        <Frame x:Name="mainframe" Grid.Column="1"/>
    </Grid>
</Page>
