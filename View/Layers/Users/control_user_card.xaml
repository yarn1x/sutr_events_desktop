<UserControl x:Class="college_events_desktop.View.Layers.Users.control_user_card"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:college_events_desktop.View.Layers.Users"
             xmlns:control="clr-namespace:college_events_desktop.View.Controls"
             mc:Ignorable="d" 
             d:Width="600">
    <Button x:Name="btn_user_card" Style="{DynamicResource ButtonStyle_filter}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="btn_user_card_Click" >

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <control:AvatarImage Margin="10" Height="90"/>

            <Grid Grid.Column="1" Margin="0, 10, 10, 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="text_fullname" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" d:Text="_User.firstname _User.surname _User.lastname" VerticalAlignment="Center" FontSize="14" Foreground="Black">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} {1} {2}">
                            <Binding Path="surName"/>
                            <Binding Path="firstName"/>
                            <Binding Path="lastName"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <StackPanel x:Name="stack_user_roles" Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Нет ролей"/>
                </StackPanel>

            </Grid>
        </Grid>
    </Button>
</UserControl>
