<UserControl x:Class="college_events_desktop.View.Controls.users_nav_buttons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:college_events_desktop.View.Controls"
             mc:Ignorable="d">
    <Grid>
        <Border Padding="10" CornerRadius="10" Background="White" BorderThickness="1" BorderBrush="#FF666666" >
            <StackPanel>
                <Button Style="{DynamicResource ButtonStyle_accent}" BorderBrush="{x:Null}" Background="#FF0070CC" Height="35" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,10,0">
                        <Border Background="White" Width="23" Height="23" Margin="0,0,5,0">
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="/View/Resources/ico_rectangle_list_solid.png"/>
                            </Border.OpacityMask>
                        </Border>
                        <TextBlock Text="Список" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_new_user" Style="{DynamicResource ButtonStyle_accent}" BorderBrush="{x:Null}" Background="#FF0070CC" Height="35" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Cursor="Hand" Click="create_new_user_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,10,0">
                        <Border Background="White" Width="23" Height="23" Margin="0,0,5,0">
                            <Border.OpacityMask>
                                <ImageBrush ImageSource="/View/Resources/ico_user_add.png"/>
                            </Border.OpacityMask>
                        </Border>
                        <TextBlock Text="Новый" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
