<UserControl x:Class="college_events_desktop.View.Controls.Containers.MultiComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:college_events_desktop.View.Controls.Containers"
             mc:Ignorable="d" >
    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- Контейнер для отображения выбранных элементов в виде кнопок -->
        <ItemsControl x:Name="SelectedItemsControl" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Кнопка удаления. Tag хранит сам объект T, Content — его строковое представление -->
                    <Button Content="{Binding DisplayText}" 
                            Tag="{Binding Value}"
                            Style="{StaticResource ButtonStyle_X}"
                            Click="RemoveButton_Click"
                            Margin="2,5" 
                            Padding="5,2"
                            Cursor="Hand">
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Выпадающий список -->
        <ComboBox x:Name="MainComboBox" 
                  DisplayMemberPath="{Binding DisplayMemberPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  ToolTip="Добавить элемент" 
                  Margin="5" 
                  FontSize="14" 
                  VerticalAlignment="Center" 
                  Foreground="#FF666666" 
                  MinWidth="80" 
                  SelectionChanged="MainComboBox_SelectionChanged" 
                  Cursor="Hand" Style="{DynamicResource ModernComboBoxStyle}"/>
    </WrapPanel>
</UserControl>
