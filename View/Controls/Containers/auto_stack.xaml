<UserControl x:Class="college_events_desktop.View.Controls.Containers.auto_stack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:college_events_desktop.View.Controls.Containers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Visible" Style="{DynamicResource MinimalScrollViewerStyle}">
        <StackPanel x:Name="stack"/>
    </ScrollViewer>
</UserControl>
