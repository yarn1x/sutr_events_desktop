<UserControl x:Class="college_events_desktop.View.Controls.loading_interface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <TextBlock Text="Загрузка" VerticalAlignment="Center" 
                   Foreground="#FF1455AB" HorizontalAlignment="Center" 
                   FontSize="16" Margin="0,70,0,0"/>

        <Border x:Name="icon" RenderTransformOrigin="0.5,0.5" 
                Background="#FF1455AB" Width="25" Height="25" 
                VerticalAlignment="Center" HorizontalAlignment="Center" 
                Margin="0,0,25,12">
            <Border.RenderTransform>
                <RotateTransform/>
            </Border.RenderTransform>
            <Border.OpacityMask>
                <ImageBrush ImageSource="../Resources/icons/ico_gear.png"/>
            </Border.OpacityMask>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="-360" Duration="0:0:1.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>

        <Border x:Name="icon2" RenderTransformOrigin="0.5,0.5" 
                Background="#FF1455AB" Width="30" Height="30" 
                VerticalAlignment="Center" HorizontalAlignment="Center" 
                Margin="25,0,0,0">
            <Border.RenderTransform>
                <RotateTransform/>
            </Border.RenderTransform>
            <Border.OpacityMask>
                <ImageBrush ImageSource="../Resources/icons/ico_gear.png"/>
            </Border.OpacityMask>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:1.5"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
        </Border>
    </Grid>
</UserControl>