<Window x:Class="college_events_desktop.View.Windows.LoginWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:college_events_desktop.View.Windows"
		mc:Ignorable="d"
		Title="Вход - Администратор"
		Width="500" Height="600"
		MinHeight="600" MinWidth="800"
		WindowState="Maximized">
	<Grid x:Name="grid_main">
		<Image Source="/View/Resources/images/img_uetk_photo.png" Stretch="UniformToFill" HorizontalAlignment="Center" >
			<Image.Effect>
				<BlurEffect Radius="10"/>
			</Image.Effect>
		</Image>
		<Border Background="#4C000000"/>
		<Border MaxHeight="430" MaxWidth="390" CornerRadius="15" BorderThickness="1" Padding="15,15,15,15" BorderBrush="#FF666666" Background="White">
			<StackPanel>
                <!--головка-->
				<TextBlock Text="Вход по учётной записью" HorizontalAlignment="Center" FontSize="16" Margin="0,20,0,0"/>
				<Border Margin="0,10,0,0" Height="2" Background="#FFDDEEFF"/>

				<!--ввод логина-->
				<TextBlock Margin="0,30,0,0" Text="Логин:" Foreground="#FF666666" FontSize="14"/>
				<TextBox x:Name="edit_login" SelectionBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="#FF666666" Margin="0,5,0,0" FontSize="14" Padding="2,4,2,4"/>
				
				<!--ввод пароля-->
				<TextBlock Margin="0,15,0,0" Text="Пароль:" Foreground="#FF666666" FontSize="14"/>
				<Grid Margin="0,5,0,0">

                    <PasswordBox x:Name="edit_password" SelectionBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Foreground="#FF666666" FontSize="14" Padding="2,4,2,4" VerticalContentAlignment="Center" PasswordChanged="edit_password_PasswordChanged">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=tgbtn_see_pw}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <TextBox x:Name="edit_password_view" 
                             Padding="2,4,2,4"
                             FontSize="{Binding ElementName=edit_password, Path=FontSize}"
                             Height="{Binding ElementName=edit_password, Path=Height, Mode=OneTime}"
                             Foreground="{Binding ElementName=edit_password, Path=Foreground}"
                             VerticalContentAlignment="Center" TextChanged="edit_password_view_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=tgbtn_see_pw}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    
                    <ToggleButton x:Name="tgbtn_see_pw" 
                                  Style="{DynamicResource ToggleButtonStyleExtraMinima}" 
                                  Grid.Column="1" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Right" 
                                  Margin="0,0,5,0"
                                  Width="22" Height="22"
                                  BorderBrush="{x:Null}" Click="tgbtn_see_pw_Click">
						<Border Background="{Binding ElementName=tgbtn_see_pw, Path=Foreground}" Width="14" Height="14">
							<Border.OpacityMask>
								<ImageBrush ImageSource="/View/Resources/icons/ico_eye.png"/>
							</Border.OpacityMask>
						</Border>
					</ToggleButton>
					
				</Grid>

                <!--кончик-->
				<Button x:Name="btn_login" HorizontalAlignment="Center" Width="170" Height="35" Margin="0,140,0,0" Style="{DynamicResource ButtonStyle_accent}" BorderBrush="{x:Null}" Content="Вход" Cursor="Hand" FontSize="16" Click="Login_Click"/>
				<Border Margin="0,10,0,0" Height="2" Background="#FFDDEEFF"/>
			</StackPanel>
		</Border>
		<TextBlock x:Name="text_build_version" Text="{StaticResource TextSystemVersion}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="#FFC5C5C5" FontSize="14" Margin="0,0,5,5" Background="#66000000"/>
	</Grid>
</Window>
